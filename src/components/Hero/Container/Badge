.badge {
  display: inline-flex;
  align-items: center;

  width: fit-content;

  padding: 8px 18px;

  border-radius: 999px;

  border: 1px solid rgba(56, 189, 248, .30);

  background: rgba(56,189,248,.08);

  color: #38BDF8;

  font-size: .80rem;

  font-weight: 700;

  letter-spacing: 2px;

  text-transform: uppercase;

  margin-bottom: 2rem;
}